{
  "expo": {
    "name": "OpenCode",
    "slug": "opencode-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opencode",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b2103da5-70a2-40e9-862b-efbdbc3ba404",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nixer.opencode",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "opencode.nueva",
            "UIApplicationShortcutItemTitle": "Nueva sesión",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAdd"
          },
          {
            "UIApplicationShortcutItemType": "opencode.escanear",
            "UIApplicationShortcutItemTitle": "Escanear QR",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCapturePhoto"
          },
          {
            "UIApplicationShortcutItemType": "opencode.ajustes",
            "UIApplicationShortcutItemTitle": "Ajustes",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeSettings"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenCode necesita la cámara para escanear el código QR de emparejamiento."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenCode necesita ver tus fotos para adjuntarlas al agente.",
          "cameraPermission": "OpenCode necesita la cámara para hacer una foto y adjuntarla."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2103da5-70a2-40e9-862b-efbdbc3ba404"
      }
    },
    "owner": "klnixerdev"
  }
}
